{
	"schemaVersion": 1,
	"id": "shared_inventory_mod",
	"version": "${version}",
	"name": "Shared Inventory Mod",
	"description": "A Minecraft mod that provides a shared inventory system with private paged backpacks, public shared chests, and integrated workstations.",
	"authors": [
		"Petrichor"
	],
	"contact": {
		"homepage": "https://github.com/C2C867/shared_inventory1.18.2",
		"sources": "https://github.com/C2C867/shared_inventory1.18.2"
	},
	"license": "GPL-3.0",
	"icon": "assets/shared_inventory_mod/shared_inventory_mod.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.umut.sharedInventory.SharedInventoryMod"
		],
		"client": [
			"com.umut.sharedInventory.SharedInventoryModClient"
		]
	},
	"mixins": [
		"SharedInventoryMod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.13.0",
		"minecraft": "~1.18.1",
		"java": ">=17"
	},
	"recommends": {
		"fabric-api": ">=0.46.6"
	}
}
